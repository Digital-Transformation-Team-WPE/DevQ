@{
    Layout = null;
    var empName = ViewBag.EmpName;
    var empId = ViewBag.EmpId;
    var empRole = ViewBag.EmpRole;

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Robot Program Validation</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Correct external resources -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" crossorigin="anonymous"></script>

    <!-- Required Libraries -->
    <link href="https://code.jquery.com/ui/1.13.3/themes/base/jquery-ui.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.3/jquery-ui.min.js"></script>

    <style>

        :root {
            --bg: #f4f7fb;
            --surface: #ffffff;
            --text: #111827;
            --muted: #374151;
            --muted-2: #6b7280;
            --border: #e5e7eb;
            --primary: #2563eb;
            --shadow: 0 4px 10px rgba(0,0,0,0.05);
            --fs-xs: clamp(12px, 1.6vw, 13px);
            --fs-sm: clamp(13px, 1.7vw, 14px);
            --fs-md: clamp(14px, 1.8vw, 16px);
            --fs-lg: clamp(16px, 2.0vw, 18px);
            --fs-xl: clamp(18px, 2.4vw, 22px);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            color: var(--text);
            background: var(--bg);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            display: flex;
            flex-direction: column;
        }

        /* ====== TOP HEADER ====== */
        .navbar {
            position: sticky;
            top: 0;
            width: 100%;
            background: var(--surface);
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
            box-shadow: var(--shadow);
            z-index: 1000;
        }

        .brand {
            font-size: var(--fs-xl);
            font-weight: 700;
            white-space: nowrap;
            line-height: 1.1;
        }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        /* ====== USER PROFILE ICON & DROPDOWN ====== */
        .user-icon-btn {
            background: var(--primary);
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: white;
            font-size: 20px;
            transition: background-color .2s, transform .2s;
            position: relative;
        }

        .user-icon-btn:hover {
            background: #1d4ed8;
            transform: scale(1.05);
        }

        .user-icon-btn:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

        .user-dropdown {
            position: absolute;
            top: 100%;
            right: 0;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            min-width: 240px;
            margin-top: 8px;
            display: none;
            flex-direction: column;
            z-index: 2000;
            animation: slideDown .2s ease;
        }

        .user-dropdown.active {
            display: flex;
        }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .user-profile-header {
            padding: 16px;
            border-bottom: 1px solid var(--border);
        }

        .user-profile-item {
            padding: 8px 0;
            margin: 0;
            font-size: var(--fs-sm);
        }

        .user-profile-item b {
            color: var(--muted);
        }

        .dropdown-divider {
            height: 1px;
            background: var(--border);
            margin: 8px 0;
        }

        .logout-btn-dropdown {
            width: 100%;
            padding: 12px 16px;
            border: none;
            background: transparent;
            color: var(--text);
            text-align: left;
            cursor: pointer;
            font-size: var(--fs-sm);
            transition: background-color .2s;
            border-radius: 0 0 12px 12px;
        }

        .logout-btn-dropdown:hover {
            background: #fee;
        }

        /* ====== MAIN LAYOUT WITH SIDEBAR ====== */
        .main-container {
            display: flex;
            flex: 1;
            overflow: hidden;
            padding-bottom: 10px; /* <-- Added 10px gap */
        }
        
        /* ====== SIDEBAR ====== */
        .sidebar {
            width: auto;
            background: var(--surface);
            border-right: 1px solid var(--border);
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 5px rgba(0,0,0,0.05);
            margin-top: 20px;
            border-radius: 10px;
            margin-bottom: 10px;
        }

        .nav-center {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 16px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            text-decoration: none;
            color: var(--muted);
            font-size: var(--fs-md);
            padding: 12px 16px;
            border-radius: 8px;
            transition: color .2s, background-color .2s, border-left .2s;
            border-left: 3px solid transparent;
        }

        .nav-item:hover {
            color: var(--primary);
            background: #eff6ff;
        }

        .nav-item.active {
            color: var(--primary);
            font-weight: 600;
            background: #eff6ff;
            border-left-color: var(--primary);
        }

        .nav-item .material-icons {
            font-size: 24px;
            line-height: 1;
        }

        /* ====== CONTENT AREA ====== */
        .content {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
        }

        .content-box {
            width: 100%;
            max-width: 1800px;
            background: var(--surface);
            padding: clamp(14px, 1vw, 30px);
            border-radius: 12px;
            min-height: auto;
            margin: 0 auto;
            box-shadow: var(--shadow);
        }

        /* ====== RESPONSIVE - MOBILE: HIDE SIDEBAR ====== */
        @@media (max-width: 768px) {
            .sidebar {
                position: absolute;
                left: 0;
                top: 60px;
                width: 100%;
                max-width: 280px;
                transform: translateX(-100%);
                transition: transform .3s ease;
                z-index: 999;
                border-right: none;
                border-bottom: 1px solid var(--border);
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .navbar {
                padding: 12px 16px;
            }

            .navbar-right {
                gap: 12px;
            }

            .content {
                padding: 16px;
            }

            .content-box {
                padding: 14px;
            }
        }

        @@media (min-width: 769px) {
            .sidebar {
                position: relative;
                transform: translateX(0) !important;
            }
        }

        /* Reduce motion */
       /*  @@media (prefers-reduced-motion: reduce) {
            * {
                animation: none !important;
                transition: none !important;
                scroll-behavior: auto !important;
            }
        } */
    </style>

</head>

<body>

    <!-- TOP HEADER -->
    <header class="navbar">
        <h2 class="brand">Robot Program Validation</h2>

        <div class="navbar-right">
            <!-- User Profile Icon with Dropdown -->
            <div style="position: relative;">
                <button class="user-icon-btn" id="userProfileBtn" aria-label="User profile" aria-expanded="false">
                    <span class="material-icons">account_circle</span>
                </button>

                <div class="user-dropdown" id="userDropdown" role="menu">
                    <div class="user-profile-header">
                        <div class="user-profile-item"><b>Name:</b> @empName</div>
                        <div class="user-profile-item"><b>ID:</b> @empId</div>
                        <div class="user-profile-item"><b>Role:</b> @empRole</div>
                    </div>
                    <div class="dropdown-divider"></div>
                    <form asp-controller="Login" asp-action="Logout" method="post" style="width: 100%;">
                        <button type="submit" class="logout-btn-dropdown" role="menuitem">
                            <span class="material-icons" style="vertical-align: middle; margin-right: 8px; font-size: 18px;">logout</span>
                            Logout
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN LAYOUT -->
    <div class="main-container">
        <!-- LEFT SIDEBAR -->
        <aside class="sidebar" id="sidebar" aria-label="Navigation">
            <nav class="nav-center">
                <a href="#" class="nav-item" data-controller="Home" data-action="Home">
                    <span class="material-icons">home</span>
                    <span>Home</span>
                </a>
                <a href="#" class="nav-item" data-controller="Access" data-action="Access">
                    <span class="material-icons">security</span>
                    <span>Access</span>
                </a>
                <a href="#" class="nav-item" data-controller="Database" data-action="Database">
                    <span class="material-icons">storage</span>
                    <span>Database</span>
                </a>
                <a href="#" class="nav-item" data-controller="Comparison" data-action="Index">
                    <span class="material-icons">compare</span>
                    <span>Comparison</span>
                </a>
                <a href="#" class="nav-item" data-controller="Settings" data-action="Index">
                    <span class="material-icons">settings</span>
                    <span>Settings</span>
                </a>
            </nav>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="content" id="main" tabindex="-1">
            <section class="content-box" id="mainContainer" aria-live="polite" aria-busy="false">
                <!-- Home content will be loaded via AJAX -->
            </section>
        </main>
    </div>


    <!-- PAGE LOADING SCRIPT -->
    <script>
        /*******************************
         *  USER PROFILE DROPDOWN HANDLER
         *******************************/
        $(document).ready(function () {
            const $userProfileBtn = $("#userProfileBtn");
            const $userDropdown = $("#userDropdown");

            // Toggle dropdown on click
            $userProfileBtn.on("click", function (e) {
                e.stopPropagation();
                $userDropdown.toggleClass("active");
                $userProfileBtn.attr("aria-expanded", $userDropdown.hasClass("active"));
            });

            // Close dropdown when clicking outside
            $(document).on("click", function () {
                if ($userDropdown.hasClass("active")) {
                    $userDropdown.removeClass("active");
                    $userProfileBtn.attr("aria-expanded", "false");
                }
            });

            // Close dropdown when clicking inside it (e.g., logout)
            $userDropdown.on("click", function (e) {
                if ($(e.target).closest(".logout-btn-dropdown").length ||
                    $(e.target).closest("form").length) {
                    $userDropdown.removeClass("active");
                    $userProfileBtn.attr("aria-expanded", "false");
                }
            });
        });

        /*******************************
         *  MOBILE SIDEBAR TOGGLE
         *******************************/
        function toggleSidebar() {
            $("#sidebar").toggleClass("open");
        }

        // Close sidebar when nav item clicked on mobile
        $(document).on("click", ".sidebar .nav-item", function () {
            if (window.innerWidth <= 768) {
                $("#sidebar").removeClass("open");
            }
        });

        /*******************************
         *  UTIL: parse query string
         *******************************/
        function getQueryParam(name) {
            const url = new URL(window.location.href);
            return url.searchParams.get(name);
        }

        /*******************************
         *  UTIL: map "section" -> {controller, action}
         *******************************/
        function sectionToRoute(section) {
            // Normalize
            const s = (section || '').toLowerCase();

            switch (s) {
                case 'access':
                    return { controller: 'Access', action: 'Access' };
                case 'database':
                    return { controller: 'Database', action: 'Database' };
                case 'comparison':
                    return { controller: 'Comparison', action: 'Index' };
                case 'settings':
                    return { controller: 'Settings', action: 'Index' };
                case 'home':
                default:
                    return { controller: 'Home', action: 'Home' };
            }
        }

        /*******************************
         *  ACCESS PAGE INIT LOGIC
         *******************************/
        function initAccessPage() {

            const $name = $("#employeeName");
            const $id = $("#employeeId");
            const $role = $("#role");
            const $status = $("#status");
            const $idRevoke = $("#employeeId_revoke");

            if (!$name.length) return;

            function mode() {
                return $('input[name="ActionType"]:checked').val();
            }
            function syncRevoke() { if ($idRevoke.length) $idRevoke.val($id.val()); }
            $id.on("input change", syncRevoke);

            $name.autocomplete({
                minLength: 2,
                delay: 200,
                source: function (req, res) {
                    $.ajax({
                        url: "/Access/SearchSuggestions",
                        data: { term: req.term, actionType: mode() },
                        success: res,
                        error: () => res([])
                    });
                },
                select: function (event, ui) {
                    // fill fields
                    $name.val(ui.item.value);
                    $id.val(ui.item.employeeId);
                    if (ui.item.role) $role.val(ui.item.role);
                    if (ui.item.status) $status.val(ui.item.status);
                    syncRevoke();
                    return false;
                }
            });
        }

        /*******************************
         *  LOAD ANY PAGE INTO MAIN CONTAINER
         *******************************/
        function loadPage(controller, action, el, pushState = false) {
            // show loading state
            $("#mainContainer").attr("aria-busy", "true");

            $.get(`/${controller}/${action}`, function (html) {
                $("#mainContainer").html(html);
                $("#mainContainer").attr("aria-busy", "false");

                if (controller === "Access") {
                    initAccessPage();
                }

                // nav active state
                $(".nav-item").removeClass("active");
                if (el) $(el).addClass("active");

                // Update URL (?section=...)
                if (pushState) {
                    const section = controller.toLowerCase(); // e.g., access, home
                    const url = new URL(window.location.href);
                    url.searchParams.set('section', section);
                    history.pushState({ section }, '', url.toString());
                }
            });
        }

        /*******************************
         *  NAV CLICK HANDLER
         *******************************/
        $(document).on("click", ".nav-item", function (e) {
            e.preventDefault();

            const controller = $(this).data("controller");
            const action = $(this).data("action");

            loadPage(controller, action, this, /* pushState */ true);
        });

        /*******************************
         *  HANDLE BACK/FORWARD
         *******************************/
        window.addEventListener('popstate', function (evt) {
            const section = (evt.state && evt.state.section) || getQueryParam('section') || 'home';
            const route = sectionToRoute(section);

            // Find corresponding nav link to mark as active
            const el = $(`.nav-item[data-controller="${route.controller}"][data-action="${route.action}"]`)[0];
            loadPage(route.controller, route.action, el, /* pushState */ false);
        });

        /*******************************
         *  STARTUP: READ ?section=...
         *******************************/
        $(function () {
            const section = getQueryParam('section') || 'home';
            const route = sectionToRoute(section);

            // Find corresponding nav link to mark active
            const el = $(`.nav-item[data-controller="${route.controller}"][data-action="${route.action}"]`)[0];

            loadPage(route.controller, route.action, el, /* pushState */ false);
        });

        async function loadSection(section) {
            const url = '@Url.Action("LoadSection", "MainPage")' + '?section=' + encodeURIComponent(section);
            const resp = await fetch(url, {
                method: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const html = await resp.text();

            const host = document.getElementById('content-host');
            host.innerHTML = html;

            // Reparse validation for new DOM
            if (window.$ && $.validator && $.validator.unobtrusive) {
                $.validator.unobtrusive.parse(host);
            }

            // Init for this section
            switch ((section || '').toLowerCase()) {
                case 'database':
                    if (window.DatabasePage?.init) window.DatabasePage.init();
                    break;
                case 'home':
                    if (window.HomePage?.init) window.HomePage.init();
                    
                    break;
                case 'access':
                    if (window.AccessPage?.init) window.AccessPage.init();
                    break;
                // ...
            }
        }

    </script>
</body>
</html>
