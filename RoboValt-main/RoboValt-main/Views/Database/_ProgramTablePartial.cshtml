@model List<Dictionary<string, object>>

@if (Model != null && Model.Any())
{
    var columns = Model.First().Keys.ToList();

    <table id="programDataTable" class="custom-table">
        <thead>
            <tr>
                <th>Select</th>
                @foreach (var col in columns)
                {
                    <th>@col</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>
                        <input type="radio" name="rowSelect" class="rowSelector" />
                    </td>

                    @foreach (var col in columns)
                    {
                        <td contenteditable="false">@row[col]</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p style="padding:10px;">No data found.</p>
}